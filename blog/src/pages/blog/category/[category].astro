---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { category: "conteudo" } },
    { params: { category: "ux-ui-design" } },
    { params: { category: "front-end" } }
  ];
}

const { category } = Astro.params;
const posts = await getCollection('blog');

const filteredPosts = posts.filter((post) => {
  const postCategory = String(post.data.category ?? "")
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .trim();

  const currentCategory = String(category ?? "")
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .trim();

  return postCategory === currentCategory;
});

const base = import.meta.env.BASE_URL;
---

<h1>{category}</h1>

{filteredPosts.length === 0 ? (
  <p>Nenhum post encontrado nesta categoria ainda.</p>
) : (
  <div class="grid">
    {filteredPosts.map((post) => (
      <div class="card">
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <a href={`${base}blog/${post.id}/`}>Ler mais</a>
      </div>
    ))}
  </div>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .card {
    border: 2px solid black;
    padding: 1.5rem;
    box-shadow: 5px 5px 0 black;
    border-radius: 10px;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>