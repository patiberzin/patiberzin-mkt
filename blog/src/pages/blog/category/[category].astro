---
import { getCollection } from 'astro:content';

// 🧪 ROTAS FIXAS (teste seguro — depois você pode voltar ao dinâmico)
export async function getStaticPaths() {
  return [
    { params: { category: "conteudo" } },
    { params: { category: "ux-ui-design" } },
    { params: { category: "front-end" } }
  ];
}

// 👉 categoria vinda da URL
const { category } = Astro.params;

// 👉 pega todos os posts
const posts = await getCollection('blog');

// 🔥 FILTRO CORRIGIDO (remove espaços, acentos e diferenças invisíveis)
const filteredPosts = posts.filter((post) => {
  const postCategory = String(post.data.category ?? "")
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .trim();

  const currentCategory = String(category ?? "")
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .trim();

  return postCategory === currentCategory;
});
---

<h1>{category}</h1>

{filteredPosts.length === 0 ? (
  <div>
    <p>Nenhum post encontrado nesta categoria ainda.</p>

    <!-- DEBUG (pode apagar depois) -->
    <p>Total de posts carregados: {posts.length}</p>

    <h2>Posts disponíveis:</h2>
    <ul>
      {posts.map((post) => (
        <li>
          {post.data.title} — {post.data.category}
        </li>
      ))}
    </ul>
  </div>
) : (
  <div class="grid">
    {filteredPosts.map((post) => (
      <div class="card">
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>

        <a href={`/blog/${post.id}/`}>
          Ler artigo
        </a>
      </div>
    ))}
  </div>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .card {
    border: 2px solid black;
    padding: 1.5rem;
    box-shadow: 5px 5px 0 black;
    border-radius: 10px;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>